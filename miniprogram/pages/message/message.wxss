.conv {
  display: flex; align-items: center;
  background: #fff; padding: 28rpx 24rpx;
  border-bottom: 2rpx solid var(--line);
}
.c-avatar {
  width: 84rpx; height: 84rpx; border-radius: 42rpx;
  background: linear-gradient(135deg, #2E5BFF, #7B9BFF);
  color: #fff; font-size: 32rpx; font-weight: 600;
  display: flex; align-items: center; justify-content: center;
  margin-right: 22rpx; flex-shrink: 0;
}
.c-sys { background: linear-gradient(135deg, #F79009, #FDB022); }

.c-body { flex: 1; min-width: 0; }
.c-top { display: flex; align-items: center; }
.c-name { font-size: 29rpx; font-weight: 500; margin-right: 12rpx; }
.c-time { margin-left: auto; font-size: 22rpx; color: var(--ink-3); flex-shrink: 0; }
.c-last {
  font-size: 25rpx; color: var(--ink-3); margin-top: 10rpx;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}

.c-dot {
  min-width: 34rpx; height: 34rpx; border-radius: 17rpx;
  background: #F04438; color: #fff;
  font-size: 20rpx; display: flex; align-items: center; justify-content: center;
  padding: 0 8rpx; margin-left: 16rpx; flex-shrink: 0;
}

.tip {
  font-size: 23rpx; color: var(--ink-2);
  background: #FFF8E6; margin: 24rpx; padding: 24rpx;
  border-radius: 16rpx; line-height: 1.7;
}
