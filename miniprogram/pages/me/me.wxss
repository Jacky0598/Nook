.uhead {
  display: flex; align-items: center;
  background: #fff; padding: 44rpx 28rpx 36rpx;
}
.u-avatar {
  width: 120rpx; height: 120rpx; border-radius: 60rpx;
  background: linear-gradient(135deg, #2E5BFF, #7B9BFF);
  color: #fff; font-size: 48rpx; font-weight: 600;
  display: flex; align-items: center; justify-content: center;
  margin-right: 26rpx; flex-shrink: 0;
}
.u-meta { flex: 1; min-width: 0; }
.u-name { font-size: 38rpx; font-weight: 700; }
.u-sub { font-size: 25rpx; color: var(--ink-3); margin-top: 8rpx; }
.u-badges { margin-top: 14rpx; }

.upsell {
  display: flex; align-items: center;
  background: linear-gradient(135deg, #2E5BFF, #5B7BFF);
  border-radius: 20rpx; margin: 20rpx 24rpx;
  padding: 28rpx;
}
.up-body { flex: 1; }
.up-t { font-size: 29rpx; font-weight: 600; color: #fff; }
.up-d { font-size: 23rpx; color: rgba(255,255,255,.85); margin-top: 10rpx; line-height: 1.6; }
.up-arrow { font-size: 44rpx; color: rgba(255,255,255,.7); margin-left: 16rpx; line-height: 1; }

.roletab {
  display: flex; background: #fff;
  margin: 20rpx 24rpx 0; border-radius: 16rpx; padding: 8rpx;
}
.rt {
  flex: 1; text-align: center; font-size: 27rpx;
  padding: 18rpx 0; border-radius: 12rpx; color: var(--ink-2);
}
.rt-on { background: var(--brand-soft); color: var(--brand); font-weight: 600; }

.stats {
  display: flex; background: #fff;
  margin: 20rpx 24rpx 0; border-radius: 20rpx; padding: 32rpx 0;
}
.st { flex: 1; text-align: center; }
.st-v { font-size: 36rpx; font-weight: 700; }
.st-k { font-size: 22rpx; color: var(--ink-3); margin-top: 8rpx; }
.stars { color: var(--warn); }

.cells { background: #fff; margin: 20rpx 24rpx; border-radius: 20rpx; overflow: hidden; }
.cell {
  display: flex; align-items: center; justify-content: space-between;
  padding: 30rpx 28rpx; font-size: 28rpx;
  border-bottom: 2rpx solid var(--line);
}
.cell:last-child { border-bottom: none; }
.arrow { color: var(--ink-3); font-size: 34rpx; }

.foot-note {
  text-align: center; font-size: 22rpx; color: var(--ink-3);
  padding: 24rpx 60rpx 40rpx; line-height: 1.7;
}
