.topbar {
  background: #fff;
  padding: 20rpx 24rpx 24rpx;
}
.search-box {
  display: flex;
  align-items: center;
  height: 76rpx;
  background: var(--bg);
  border-radius: 38rpx;
  padding: 0 28rpx;
}
.search-icon { font-size: 26rpx; margin-right: 12rpx; }
.search-input { flex: 1; font-size: 27rpx; }
.ph { color: var(--ink-3); }

.school-pick {
  display: inline-flex;
  align-items: center;
  margin-top: 20rpx;
  background: var(--brand-soft);
  border-radius: 24rpx;
  padding: 8rpx 20rpx;
}
.school-name { font-size: 24rpx; color: var(--brand); font-weight: 500; }
.school-caret { font-size: 20rpx; color: var(--brand); margin-left: 8rpx; }

/* 分类 */
.cats {
  display: flex;
  background: #fff;
  padding: 8rpx 12rpx 32rpx;
  margin-bottom: 8rpx;
}
.cat { flex: 1; display: flex; flex-direction: column; align-items: center; }
.cat-icon {
  width: 88rpx; height: 88rpx;
  border-radius: 26rpx;
  background: var(--bg);
  display: flex; align-items: center; justify-content: center;
  font-size: 40rpx;
  margin-bottom: 12rpx;
}
.cat-name { font-size: 23rpx; color: var(--ink-2); }

/* 服务卡片 */
.listing-title { font-size: 31rpx; font-weight: 600; line-height: 1.45; }

.seller-row { display: flex; align-items: center; margin-top: 22rpx; }
.avatar {
  width: 64rpx; height: 64rpx; border-radius: 32rpx;
  background: linear-gradient(135deg, #2E5BFF, #7B9BFF);
  color: #fff; font-size: 28rpx; font-weight: 600;
  display: flex; align-items: center; justify-content: center;
  margin-right: 16rpx; flex-shrink: 0;
}
.seller-meta { flex: 1; min-width: 0; }
.seller-line1 { display: flex; align-items: baseline; }
.seller-name { font-size: 27rpx; font-weight: 500; }
.seller-sub { font-size: 22rpx; color: var(--ink-3); margin-left: 8rpx; }
.seller-line2 { margin-top: 8rpx; }

.stat-row { display: flex; align-items: center; margin-top: 16rpx; font-size: 24rpx; }
.stars { color: var(--warn); font-weight: 600; }
.dot { color: var(--ink-3); margin: 0 10rpx; }

.tag-row { margin-top: 16rpx; }
.tag {
  display: inline-block;
  font-size: 22rpx; color: var(--ink-2);
  background: var(--bg);
  padding: 6rpx 16rpx; border-radius: 8rpx;
  margin: 0 10rpx 8rpx 0;
}

.listing-foot {
  display: flex; align-items: center; justify-content: space-between;
  margin-top: 24rpx; padding-top: 22rpx;
  border-top: 2rpx solid var(--line);
}

/* 需求卡片 */
.req-head { display: flex; justify-content: space-between; align-items: baseline; }
.req-title { font-size: 30rpx; font-weight: 600; flex: 1; }
.req-time { font-size: 22rpx; color: var(--ink-3); margin-left: 16rpx; flex-shrink: 0; }
.req-desc {
  font-size: 26rpx; color: var(--ink-2); line-height: 1.6; margin-top: 14rpx;
}
.req-meta { margin-top: 18rpx; }
.chip {
  display: inline-block;
  font-size: 23rpx; color: var(--brand);
  background: var(--brand-soft);
  padding: 8rpx 16rpx; border-radius: 8rpx;
  margin: 0 10rpx 8rpx 0;
}

.foot-note {
  text-align: center;
  font-size: 22rpx;
  color: var(--ink-3);
  padding: 32rpx 60rpx 20rpx;
  line-height: 1.6;
}
