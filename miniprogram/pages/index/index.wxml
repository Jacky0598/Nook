<view class="page">

  <!-- 顶部：搜索 + 学校切换 -->
  <view class="topbar">
    <view class="search-row">
      <view class="search-box">
        <text class="search-icon">🔍</text>
        <input
          class="search-input"
          placeholder="搜课程代码 / 服务，如 ETC1000"
          placeholder-class="ph"
          value="{{keyword}}"
          bindinput="onSearchInput"
          bindconfirm="onSearchConfirm"
          confirm-type="search" />
      </view>
    </view>
    <picker mode="selector" range="{{schools}}" value="{{schoolIndex}}" bindchange="onSchoolChange">
      <view class="school-pick">
        <text class="school-name">{{school}}</text>
        <text class="school-caret">▾</text>
      </view>
    </picker>
  </view>

  <!-- 分类入口 -->
  <view class="cats">
    <view class="cat" wx:for="{{categories}}" wx:key="key" data-key="{{item.key}}" bindtap="goCategory">
      <view class="cat-icon">{{item.icon}}</view>
      <text class="cat-name">{{item.name}}</text>
    </view>
  </view>

  <!-- 本周热门 -->
  <view class="section-head">
    <text class="section-title">本周热门</text>
    <text class="section-more">按好评排序</text>
  </view>

  <view class="card listing" wx:for="{{hotListings}}" wx:key="id" data-id="{{item.id}}" bindtap="goDetail">
    <view class="listing-title">{{item.title}}</view>

    <view class="seller-row">
      <view class="avatar">{{item.seller.initial}}</view>
      <view class="seller-meta">
        <view class="seller-line1">
          <text class="seller-name">{{item.seller.name}}</text>
          <text class="seller-sub">· {{item.school}} · {{item.seller.year}}</text>
        </view>
        <view class="seller-line2">
          <text class="badge badge-{{b.type}}" wx:for="{{item.seller.badges}}" wx:for-item="b" wx:key="text">{{b.text}}</text>
        </view>
      </view>
    </view>

    <view class="stat-row">
      <text class="stars">⭐ {{item.seller.rating}}</text>
      <text class="muted">（{{item.seller.reviewCount}} 条评价）</text>
      <text class="dot">·</text>
      <text class="muted">已完成 {{item.seller.orderCount}} 单</text>
    </view>

    <view class="tag-row">
      <text class="tag" wx:for="{{item.tags}}" wx:for-item="t" wx:key="*this">{{t}}</text>
    </view>

    <view class="listing-foot">
      <view class="price">
        <text class="price-unit">RM </text><text class="price-num">{{item.price}}</text>
        <text class="price-unit"> / {{item.unit}}</text>
      </view>
      <view class="btn btn-primary">咨询</view>
    </view>
  </view>

  <!-- 求助中 -->
  <view class="section-head">
    <text class="section-title">求助中 · 等你报价</text>
    <text class="section-more">{{requests.length}} 条</text>
  </view>

  <view class="card request" wx:for="{{requests}}" wx:key="id">
    <view class="req-head">
      <text class="req-title">{{item.title}}</text>
      <text class="req-time">{{item.createdText}}</text>
    </view>
    <view class="req-desc">{{item.desc}}</view>
    <view class="req-meta">
      <text class="chip">💰 RM {{item.budgetMin}}–{{item.budgetMax}}</text>
      <text class="chip">⏰ {{item.deadline}}</text>
      <text class="chip">📍 {{item.location}}</text>
    </view>
    <view class="listing-foot">
      <text class="muted">{{item.buyer.name}} · {{item.buyer.year}} · 已有 {{item.quoteCount}} 人报价</text>
      <view class="btn btn-ghost" catchtap="onTakeRequest" data-id="{{item.id}}">我来接</view>
    </view>
  </view>

  <view class="foot-note">
    平台仅提供信息撮合服务 · 严禁代写代考等学术不端行为
  </view>

</view>
